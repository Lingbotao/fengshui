/**
 * 罗盘页样式
 */

page {
  background: var(--color-bg);
}

.page-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 0 32rpx;
}

.status-bar-placeholder {
  width: 100%;
}

/* ==================== 罗盘容器 ==================== */
.compass-container {
  width: 520rpx;
  height: 520rpx;
  margin: 32rpx 0;
}

.compass-canvas {
  width: 100%;
  height: 100%;
}

/* ==================== 方位信息 ==================== */
.direction-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.direction-main {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-primary);
  line-height: 1.3;
}

.direction-sub {
  font-size: 32rpx;
  color: var(--color-text-primary);
  margin-top: 8rpx;
}

.direction-angle {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

/* ==================== 校准提示 ==================== */
.calibrate-tip {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(212, 168, 67, 0.1);
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.calibrate-tip text {
  font-size: 24rpx;
  color: var(--color-warning);
}

/* ==================== 手动模式提示 ==================== */
.manual-tip {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(140, 123, 107, 0.1);
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.manual-tip text {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

/* ==================== 权限引导 ==================== */
.permission-guide {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.guide-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 48rpx;
  width: 80%;
}

.guide-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.guide-title {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.guide-desc {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 32rpx;
}

.guide-btn {
  width: 100%;
  height: 80rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.guide-skip {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

/* ==================== 底部标注 ==================== */
.footer-note {
  font-size: 24rpx;
  color: var(--color-text-hint);
  text-align: center;
  padding: 32rpx 0 64rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
}