<!--pages/index/index.wxml-->
<view class="page-container">
  <!--状态栏占位-->
  <view class="status-bar-placeholder" style="height:{{statusBarHeight}}px"></view>

  <!--日期头区域-->
  <view class="date-header">
    <view class="date-header-left">
      <text class="lunar-date">{{lunarDate}}</text>
      <text class="ganzhi-year">{{ganzhiYear}}</text>
    </view>
    <view class="date-header-right">
      <text class="gregorian-date">{{gregorianDate}}</text>
      <text class="week-day">{{weekDay}}</text>
    </view>
  </view>
  <view class="date-header-line"></view>

  <!--宜忌卡片-->
  <view class="almanac-card">
    <view class="almanac-content">
      <view class="yi-column">
        <view class="column-header">
          <van-icon name="success" color="#6B8F71" size="32rpx"/>
          <text class="column-title">宜</text>
        </view>
        <view class="column-list">
          <text wx:for="{{yiList}}" wx:key="index" class="yi-item">{{item}}</text>
        </view>
      </view>
      <view class="column-divider"></view>
      <view class="ji-column">
        <view class="column-header">
          <van-icon name="clear" color="#C46B5C" size="32rpx"/>
          <text class="column-title">忌</text>
        </view>
        <view class="column-list">
          <text wx:for="{{jiList}}" wx:key="index" class="ji-item">{{item}}</text>
        </view>
      </view>
    </view>
    <!--冲煞信息（受云端开关控制）-->
    <view wx:if="{{showChongsha}}" class="chongsha-info">
      <text class="chongsha-item">冲煞生肖：{{chongshaZodiac}}</text>
      <text class="chongsha-item">冲煞方向：煞{{chongshaDirection}}</text>
    </view>
  </view>

  <!--吉神方位（受云端开关控制）-->
  <view wx:if="{{showJishenFangWei}}" class="jishen-area">
    <view class="area-title">今日吉神方位</view>
    <view class="jishen-grid">
      <view class="jishen-item">
        <van-icon name="location" size="28rpx" color="#8C7B6B"/>
        <text class="jishen-label">财神</text>
        <text class="jishen-value">{{caishenDirection}}</text>
      </view>
      <view class="jishen-item">
        <van-icon name="location" size="28rpx" color="#8C7B6B"/>
        <text class="jishen-label">喜神</text>
        <text class="jishen-value">{{xishenDirection}}</text>
      </view>
      <view class="jishen-item">
        <van-icon name="location" size="28rpx" color="#8C7B6B"/>
        <text class="jishen-label">贵神</text>
        <text class="jishen-value">{{guishenDirection}}</text>
      </view>
    </view>
  </view>

  <!--五行穿衣（受云端开关控制）-->
  <view wx:if="{{showWuxingClothes}}" class="wuxing-area">
    <view class="area-title">今日五行穿衣</view>
    <scroll-view class="clothes-scroll" scroll-x="{{true}}">
      <view class="clothes-list">
        <view wx:for="{{wuxingClothes}}" wx:key="index" class="clothes-card {{index === 0 ? 'recommended' : ''}}">
          <view class="color-block" style="background-color: {{item.color}}">
            <text wx:if="{{index === 0}}" class="recommend-tag">推荐</text>
          </view>
          <view class="color-info">
            <text class="color-name">{{item.name}}</text>
            <text class="color-desc">{{item.description}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!--Banner广���-->
  <view class="banner-area">
    <ad unit-id="" ad-type="banner" ad-theme="white"></ad>
  </view>

  <!--仅供娱乐参考-->
  <view class="footer-note">仅供娱乐参考</view>
</view>