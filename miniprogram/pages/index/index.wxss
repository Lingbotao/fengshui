/**
 * 首页样式 - 每日宜忌 + 五行穿衣
 * 基于 UI 规格书 v1.0
 */

page {
  background: var(--color-bg);
  padding-bottom: 120rpx;
}

.page-container {
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
}

/* 状态栏占位 */
.status-bar-placeholder {
  width: 100%;
}

/* ==================== 日期头区域 ==================== */
.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  margin-bottom: 8rpx;
}

.date-header-left {
  display: flex;
  flex-direction: column;
  width: 60%;
}

.lunar-date {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.ganzhi-year {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.date-header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  width: 40%;
}

.gregorian-date {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-accent);
  line-height: 1.3;
}

.week-day {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.date-header-line {
  width: 60%;
  height: 2rpx;
  background: linear-gradient(to right, var(--color-accent), transparent);
  margin-bottom: 32rpx;
}

/* ==================== 宜忌卡片 ==================== */
.almanac-card {
  background: var(--color-card);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 50, 41, 0.06);
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.almanac-content {
  display: flex;
  justify-content: space-between;
}

.yi-column,
.ji-column {
  width: 48%;
}

.column-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.column-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-left: 8rpx;
}

.yi-column .column-title {
  color: var(--color-secondary);
}

.ji-column .column-title {
  color: var(--color-danger);
}

.column-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.yi-item,
.ji-item {
  font-size: 28rpx;
  line-height: 1.6;
}

.yi-item {
  color: var(--color-text-primary);
}

.ji-item {
  color: var(--color-text-primary);
}

.column-divider {
  width: 1rpx;
  background: var(--color-divider);
  margin: 0 16rpx;
}

.chongsha-info {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-divider);
}

.chongsha-item {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.8;
}

/* ==================== 吉神方位 ==================== */
.jishen-area {
  margin-bottom: 32rpx;
}

.area-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.jishen-grid {
  display: flex;
  justify-content: space-between;
  background: var(--color-card);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 50, 41, 0.06);
}

.jishen-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 33%;
}

.jishen-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.jishen-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  margin-top: 4rpx;
}

/* ==================== 五行穿衣 ==================== */
.wuxing-area {
  margin-bottom: 32rpx;
}

.clothes-scroll {
  white-space: nowrap;
  width: 100%;
}

.clothes-list {
  display: flex;
  gap: 16rpx;
}

.clothes-card {
  display: inline-flex;
  flex-direction: column;
  width: 296rpx;
  height: 200rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: var(--color-card);
  box-shadow: 0 4rpx 16rpx rgba(61, 50, 41, 0.06);
  flex-shrink: 0;
}

.clothes-card.recommended {
  border: 2rpx solid var(--color-accent);
}

.color-block {
  flex: 1;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 8rpx;
}

.recommend-tag {
  font-size: 20rpx;
  color: #FFFFFF;
  background: var(--color-accent);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.color-info {
  background: var(--color-card);
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.color-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.color-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== Banner 广告 ==================== */
.banner-area {
  width: 100%;
  height: 120rpx;
  margin-bottom: 32rpx;
}

/* ==================== 底部标注 ==================== */
.footer-note {
  font-size: 24rpx;
  color: var(--color-text-hint);
  text-align: center;
  padding: 32rpx 0 64rpx;
}